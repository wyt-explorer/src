# ROS 2 single-drone display: world-frame cloud, goals and odometry (SI units).
Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 30
      Reference Frame: <Fixed Frame>
      Color: 160; 160; 164
    - Class: rviz_default_plugins/PointCloud2
      Name: Obstacles
      Enabled: true
      Topic:
        Value: /map_generator/global_cloud
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 2
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 220; 180; 80
      Alpha: 1
      Style: Boxes
      Size (m): 0.1
      Decay Time: 0
    - Class: rviz_default_plugins/Marker
      Name: Start and Goal
      Enabled: true
      Marker Topic:
        Value: /my_primitive_demo/waypoint_markers
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 100
      Namespaces:
        demo_waypoints: true
    - Class: rviz_default_plugins/Odometry
      Name: Drone Odometry
      Enabled: true
      Topic:
        Value: /state/odometry
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 10
      Keep: 100
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
      Shape:
        Value: Arrow
        Color: 25; 255; 0
        Alpha: 1
        Shaft Length: 0.5
        Shaft Radius: 0.05
        Head Length: 0.2
        Head Radius: 0.1
      Covariance:
        Value: false
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/PublishPoint
      Topic: /clicked_point
      Single click: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 28
      Pitch: 0.65
      Yaw: 0.8
      Focal Point:
        X: 0
        Y: 0
        Z: 1
      Target Frame: <Fixed Frame>
Window Geometry:
  Width: 1200
  Height: 800
